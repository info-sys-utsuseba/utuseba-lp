#!/bin/sh
# josys-security — git pre-commit（強制点②：人間・外部開発者のコミット）
#
# 役割: コミットしようとしている *追加行* に、顧客の個人情報・鍵・案件間混入が
#       含まれていないかを、送信される前に止める。
#
# これは「事故を止める柵」であって「悪意を止める壁」ではない。
# --no-verify で抜けられるのは承知の上で、抜けた場合は CI（強制点④）が拾う。
#
# ★ 設計方針: **黙って通さない。**
#   検査できない状態（エンジンが無い／python3 が無い／エンジンが壊れた）は
#   「安全」ではなく「不明」である。不明を安全として扱うと、防御があるつもりのまま
#   何も動いていない状態が一番長く続く。よってすべて停止し、理由と直し方を出す。
#   急ぐときの逃げ道は git 標準の --no-verify（CI に記録が残る）。
#
# 導入: josys-security の install.sh、または案件リポの .security/install-hook.sh
set -u

die() {
  printf '\n🛑 コミットを停止しました（セキュリティ検査が実行できません）\n\n' >&2
  printf '   %s\n\n' "$1" >&2
  printf '   直し方:\n' >&2
  printf '%s\n' "$2" >&2
  printf '\n   検査できない状態を「問題なし」として通すことはしません。\n' >&2
  printf '   どうしても急ぐ場合のみ: git commit --no-verify\n' >&2
  printf '   （その場合も push 後に CI が同じ検査を行い、記録が残ります）\n\n' >&2
  exit 1
}

# ── エンジンの場所を解決する ──────────────────────────────
# ① リポ同梱を最優先する。CI が使うものと同一版になり、手元と CI の判定がずれない。
# ② 外部開発者の環境には ~/.claude-utsuseba は無い。決め打ちにしない。
ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
for c in \
  "${JOSYS_SEC_ENGINE:-}" \
  "$(git config --get josys.engine 2>/dev/null || true)" \
  "$ROOT/.security/engine.py" \
  "$HOME/.josys-security/engine/sec_detect.py" \
  "$HOME/.claude-utsuseba/hooks/sec/sec_detect.py"
do
  if [ -n "$c" ] && [ -f "$c" ]; then ENGINE="$c"; break; fi
done

if [ -z "${ENGINE:-}" ]; then
  die "検出エンジンが見つかりません。このフックは install.sh が置いたものなので、
   エンジンだけが消えている＝導入が壊れているか、削除された状態です。" \
"     ・案件リポの場合  : sh .security/install-hook.sh
     ・自分の環境の場合: sh ~/josys-security/install.sh"
fi

PY="$(command -v python3 2>/dev/null || true)"
if [ -z "$PY" ]; then
  die "python3 が見つかりません（PATH 上に存在しません）。" \
"     macOS  : xcode-select --install
     Windows: https://www.python.org/downloads/ （Add to PATH を有効に）
     Linux  : sudo apt install python3 など"
fi

OUT="$("$PY" "$ENGINE" --repo "$ROOT" --staged --strict 2>&1)"
RC=$?

case "$RC" in
  0) : ;;                                  # clean
  1) [ -n "$OUT" ] && printf '\n%s\n\n' "$OUT" >&2 ;;   # WARN は通す。止めない
  2)
    printf '\n%s\n\n' "$OUT" >&2
    printf '  → 直したら再度 git commit。誤検知なら .security/allow.txt に1行追加。\n' >&2
    printf '  → どうしても急ぐ場合のみ: git commit --no-verify（理由を残すこと）\n' >&2
    printf '  → なお --no-verify で抜けても、push 後に CI が同じ判定を出します。\n\n' >&2
    exit 1
    ;;
  *)
    # エンジンが例外で落ちた。ルールが1つも評価されていない可能性がある。
    printf '\n%s\n' "$OUT" >&2
    die "検出エンジンが異常終了しました（終了コード ${RC}）。上の出力が原因です。" \
"     ・エンジンを入れ直す: sh .security/install-hook.sh
     ・直らなければ前川へ連絡（このメッセージ全文を添えてください）"
    ;;
esac

# ── Actions のコスト事故ゲート（強制点⑥）─────────────────
# 2026-08-12、無料枠（月2,000分）の枯渇で請求書の提出チェックほか全社の自動処理が
# 止まった。原因は一発のミスではなく、各案件に積み上がった小さなワークフロー。
# GitHub の課金はジョブ単位で1分に切り上げなので、5秒の cron でも1回1分。
# 「速くする」では1円も減らない。回数を機械で抑えるしかない。
#
# ワークフローを触ったコミットのときだけ見る。既存の違反で毎回止めると、
# 関係ないコミットが通らなくなり、最終的にフックごと外される。
WFS="$(git diff --cached --name-only --diff-filter=d \
        -- '.github/workflows/*.yml' '.github/workflows/*.yaml' 2>/dev/null || true)"
if [ -n "$WFS" ]; then
  for c in \
    "$ROOT/.security/wf_cost.py" \
    "$(dirname "$ENGINE")/wf_cost.py" \
    "$HOME/.josys-security/engine/wf_cost.py"
  do
    if [ -n "$c" ] && [ -f "$c" ]; then WFC="$c"; break; fi
  done

  if [ -z "${WFC:-}" ]; then
    # 機微情報エンジンと違い、こちらは後から追加した検査。まだ配られていない
    # リポジトリが当分残るので、無い場合は止めずに知らせるだけにする。
    printf '\n⚠️  Actions コスト検査（wf_cost.py）が見つかりません。\n' >&2
    printf '   ワークフローを変更していますが、頻度・timeout の検査は行われていません。\n' >&2
    printf '   入れ直す: sh .security/install-hook.sh\n\n' >&2
  else
    # shellcheck disable=SC2086
    WOUT="$("$PY" "$WFC" --repo "$ROOT" --files $WFS --strict 2>&1)"
    WRC=$?
    case "$WRC" in
      0) : ;;
      1) [ -n "$WOUT" ] && printf '\n%s\n' "$WOUT" >&2 ;;
      2)
        printf '\n%s\n' "$WOUT" >&2
        printf '  → 直したら再度 git commit。意図的な例外なら該当行の上に\n' >&2
        printf '     `# cost-ok: <理由>` を書いてください（理由は必須）。\n' >&2
        printf '  → 急ぐ場合のみ: git commit --no-verify（CI が同じ判定を出します）\n\n' >&2
        exit 1
        ;;
      *)
        printf '\n%s\n' "$WOUT" >&2
        die "コスト検査エンジンが異常終了しました（終了コード ${WRC}）。" \
"     ・入れ直す: sh .security/install-hook.sh
     ・直らなければ前川へ連絡（このメッセージ全文を添えてください）"
        ;;
    esac
  fi
fi

# 既存の pre-commit（husky 等）を潰さない。退避先があれば続けて実行する。
LOCAL="$(git rev-parse --git-path hooks/pre-commit.local 2>/dev/null)"
if [ -n "${LOCAL:-}" ] && [ -x "$LOCAL" ]; then
  "$LOCAL" || exit $?
fi
exit 0
